+
+bool TransportLayer::dataGroupValueRequestRaw(uint16_t destinationAddress,
+                                               const uint8_t* payload,
+                                               uint8_t payloadLength)
+{
+    if (_networkLayer == nullptr || destinationAddress == 0 || destinationAddress > 0x7FFF ||
+        payload == nullptr || payloadLength == 0 || payloadLength > 14)
+        return false;
+    CemiFrame frame(payloadLength + 1);
+    APDU& apdu = frame.apdu();
+    apdu.type(GroupValueWrite);
+    memcpy(apdu.data() + 1, payload, payloadLength);
+    _networkLayer->dataGroupRequest(AckRequested, destinationAddress,
+                                    NetworkLayerParameter, LowPriority, frame.tpdu());
+    return true;
+}
+
 void TransportLayer::dataIndividualIndication(uint16_t destination, HopCountType hopType, Priority priority, uint16_t source, TPDU& tpdu)
 {
     //if (tpdu.apdu().length() > 0)
@@ -366,3 +389,18 @@ void TransportLayer::dataGroupIndication(uint16_t destination, HopCountType hopType, Priority priority, uint16_t source, TPDU& tpdu)
 {
+    if (_rawGroupObserver != nullptr && tpdu.apdu().type() == GroupValueWrite)
+    {
+        uint8_t len = tpdu.apdu().length();
+        uint8_t dataArray[0xff];
+        memcpy(dataArray, tpdu.apdu().data(), len);
+        if (len == 1)
+            dataArray[0] &= 0x3f;
+        else if (len > 1)
+        {
+            memmove(dataArray, dataArray + 1, len - 1);
+            --len;
+        }
+        _rawGroupObserver(_rawGroupObserverContext, source, destination, dataArray, len);
+    }
+
     if (_groupAddressTable == nullptr)
         return;
