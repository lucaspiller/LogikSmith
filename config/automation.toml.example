# Copy this file to config/automation.toml and replace every KNX placeholder.
# Use only harmless visible actuators for manual tests.

[[blocks]]
id = "staircase"
revision = 1
enabled = true
source = '''
function handle(event, input, meta, state)
    if event.input == "wall_switch" and event.rising then
        return { outputs = { test_light = true }, timers = { off = { after = seconds(5) } } }
    elseif event.type == "timer" and event.timer == "off" then
        return { outputs = { test_light = false } }
    end
end
'''

[[blocks.schedules]]
name = "morning_on"
enabled = true
kind = "astronomical"
anchor = "sunrise"
offset = "-1h30m"
earliest = "05:30"

[[blocks.schedules]]
name = "morning_off"
enabled = true
kind = "astronomical"
anchor = "sunrise"
offset = "30m"

[[blocks.schedules]]
name = "weekday_evening_on"
enabled = true
kind = "astronomical"
anchor = "sunset"
offset = "-1h30m"
weekdays = ["mon", "tue", "wed", "thu", "fri"]

[[blocks.schedules]]
name = "evening_off"
enabled = true
kind = "fixed"
at = "23:30"

[[blocks.schedules]]
name = "heartbeat"
enabled = true
kind = "interval"
every = "60s"
offset = "0s"

[[blocks.inputs]]
name = "wall_switch"
dpt = "1.001"

[[blocks.outputs]]
name = "test_light"
dpt = "1.001"

[[blocks.knx_bindings]]
endpoint = "wall_switch"
group_address = "REPLACE_WITH_INPUT_GROUP_ADDRESS"

[[blocks.knx_bindings]]
endpoint = "test_light"
group_address = "REPLACE_WITH_SAFE_OUTPUT_GROUP_ADDRESS"

[[blocks]]
id = "utility_light"
revision = 1
enabled = true
source = '''
function handle(event, input)
    if event.type == "input" and event.rising then
        return { outputs = { test_light = true } }
    end
end
'''

[[blocks.inputs]]
name = "button"
dpt = "1.001"

[[blocks.outputs]]
name = "test_light"
dpt = "1.001"

[[blocks.knx_bindings]]
endpoint = "button"
group_address = "REPLACE_WITH_SECOND_INPUT_GROUP_ADDRESS"

[[blocks.knx_bindings]]
endpoint = "test_light"
group_address = "REPLACE_WITH_SECOND_SAFE_OUTPUT_GROUP_ADDRESS"
